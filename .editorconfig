# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
ij_javascript_spaces_within_object_literal_braces = true
ij_javascript_spaces_within_imports = true
max_line_length = off